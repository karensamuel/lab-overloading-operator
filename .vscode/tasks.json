{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run in External Terminal",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-I",
                "include",
                "src/*.cpp",
                "-o",
                "app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile all source files and run in external terminal",
            "dependsOn": "Run Application",
            "dependsOrder": "sequence"
        },
        {
            "label": "Run Application",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "g++ -std=c++17 -I include src/*.cpp -o app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}